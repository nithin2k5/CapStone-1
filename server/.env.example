# Application
APP_NAME=Secure Email Gateway
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/seg_db

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE=30
JWT_REFRESH_EXPIRE_DAYS=7

# Google OAuth / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# DKIM verification. Needs the message exactly as it arrived, which Gmail serves
# as a second request per message. Set false to halve the API calls per fetch and
# fall back to the verdict the receiving server reported.
DKIM_VERIFY_ENABLED=true

# Password reset. The link is a short-lived token bound to the password hash it
# was issued against, so using it — or issuing a newer one — retires it.
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000

# SMTP, used only to deliver the reset link. With SMTP_HOST unset the link is
# written to the server log instead, which is fine for a local install and is
# not fine anywhere the log has other readers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_STARTTLS=true

# Redis (optional)
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting (ready)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# Gmail push notifications.
#
# Polling leaves a message judged dangerous live in the inbox for up to one
# sweep interval — the window in which a user only has to click once. A watch
# closes that to a round trip. This needs infrastructure the application cannot
# create for itself, so it ships off; with it off the sweep below is the only
# path and still works, now cursor-based.
#
# To turn it on:
#   1. Create a Pub/Sub topic, and grant
#      gmail-api-push@system.gserviceaccount.com the Pub/Sub Publisher role on
#      it. Gmail publishes as that account and cannot publish without it.
#   2. Create a push subscription on the topic whose endpoint is
#      https://<public-host>/api/v1/gmail/push, with an OIDC service account
#      and an audience. The endpoint must be reachable from the internet and
#      served over TLS — for local work, a tunnel.
#   3. Set the four values below. GMAIL_PUSH_SERVICE_ACCOUNT and
#      GMAIL_PUSH_AUDIENCE are what the endpoint checks each notification
#      against; with either unset it refuses every notification rather than
#      accepting unverified ones.
GMAIL_PUSH_ENABLED=false
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_SERVICE_ACCOUNT=
GMAIL_PUSH_AUDIENCE=

# Outlook push notifications, through Microsoft Graph subscriptions.
#
# The Outlook counterpart of Gmail push. With it on, the sweep creates a Graph
# subscription per Outlook mailbox and renews it before it lapses, and Graph
# calls the URL below when mail arrives. Graph checks the URL when it creates
# each subscription, so it must be public and served over HTTPS — for local
# work, a tunnel. Each notification must carry the per-subscription secret this
# gateway chose, or it is ignored. Off by default; the sweep still covers
# Outlook mailboxes without it.
MICROSOFT_PUSH_ENABLED=false
MICROSOFT_NOTIFICATION_URL=https://your-public-host/api/v1/microsoft/push

# The fallback sweep. A safety net once push is on — it catches what a dropped
# notification or a lapsed watch would lose — and the only path when push is
# off. The interval is a floor, not a period: the sweep sleeps after finishing,
# so a slow provider cannot stack overlapping sweeps. Without push this is how
# long new mail can wait to be scanned; a sweep of a quiet mailbox is a single
# incremental request, so 30 seconds is cheap. With push on, 300 is plenty.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
# Erase delivered mail at the end of its day. Just after midnight (in the
# database's time zone), mail delivered as safe on earlier days loses its body,
# headers and detailed scan result, and leaves the Emails list. A small record
# (sender, subject, times, verdict) is kept so sender recognition and duplicate
# detection keep working. Erased mail cannot be re-scanned, so pulling back
# delivered mail on later evidence covers only the current day. Quarantined and
# blocked mail is never erased.
DISCARD_DELIVERED_DAILY=true

# A ceiling on a burst, not a window. Synchronisation resumes from a stored
# cursor, so the sweep fetches what actually arrived rather than re-reading the
# newest N and losing everything behind them.
SCHEDULER_MAX_RESULTS=100
# Gmail expires a watch after seven days and recommends renewing daily. A
# lapsed watch stops notifying without saying so.
WATCH_RENEW_INTERVAL_SECONDS=86400

# Encryption for stored mailbox credentials.
#
# This database holds Google and Microsoft refresh tokens for every connected
# user. A refresh token is durable, full-mailbox access that survives the user
# changing their password, which makes this database a higher-value target than
# any message it protects. Generate a key with:
#
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#
# Leave it empty and the tokens are stored in plain text; startup warns when
# that is the case. Keep the key OUT of this database and out of version
# control — stored next to the ciphertext it protects nothing. Losing it means
# every user must reconnect their mailbox, and rotating it means re-encrypting
# before the old key is discarded.
TOKEN_ENCRYPTION_KEY=

# At most 9 additional single-chunk model calls on concealed bodies <=6000 chars.
# A 45-second total timeout bounds the experiment. Unstable verdicts go to review.
VERDICT_STABILITY_ENABLED=true
# Only after a reproducible effect: up to 16 calls and 45 additional seconds.
FRAGMENT_ISOLATION_ENABLED=true
ACCESSIBILITY_ANALYSIS_ENABLED=true

# A note on DATABASE_URL, which is not something this file can fix: the
# development default connects as MySQL root with no password. Combined with
# the credentials above, that is the softest target in the system. Give the
# application its own user, with rights only on its own schema, before this
# runs anywhere with other readers.
