# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.
# Everything here is passed to the API container. server/.env.example documents
# every setting the API understands; the ones below are what a deployment needs.

# The public hostname, with a DNS A record pointing at this server.
DOMAIN=gateway.example.com

# Database passwords. Generate with: openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Encrypts the stored mailbox refresh tokens. Generate with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Back it up somewhere other than this server. Losing it means every user must
# reconnect their mailbox.
TOKEN_ENCRYPTION_KEY=

# The model behind the content analyser. Without it the API falls back to a
# local LLM server, which this deployment does not run.
GEMINI_API_KEY=

# Google OAuth. In Google Cloud Console, add https://<DOMAIN> as an authorised
# JavaScript origin and https://<DOMAIN>/api/v1/auth/google/callback as an
# authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gateway.example.com/api/v1/auth/google/callback

# Microsoft OAuth (optional). Register https://<DOMAIN> as a redirect URI.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# The background sweep. This is what keeps scanning running with nobody signed in,
# and, without push, how quickly new mail is noticed. Raise to 300 once push is on.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# Gmail push (optional). With a public HTTPS address it can now be turned on;
# the push endpoint is https://<DOMAIN>/api/v1/gmail/push. Setup steps are in
# server/.env.example.
GMAIL_PUSH_ENABLED=false
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_SERVICE_ACCOUNT=
GMAIL_PUSH_AUDIENCE=

# Erase delivered mail at the end of its day. Just after midnight (in the
# database's time zone), mail delivered as safe on earlier days loses its body,
# headers and detailed scan result, and leaves the Emails list. A small record
# (sender, subject, times, verdict) is kept so sender recognition and duplicate
# detection keep working. Erased mail cannot be re-scanned, so pulling back
# delivered mail on later evidence covers only the current day. Quarantined and
# blocked mail is never erased.
DISCARD_DELIVERED_DAILY=true

# Outlook push (optional). Needs nothing beyond this server's public address:
# new Outlook mail is scanned within seconds instead of at the next sweep.
MICROSOFT_PUSH_ENABLED=false
MICROSOFT_NOTIFICATION_URL=https://gateway.example.com/api/v1/microsoft/push

# Password reset email (optional). Without SMTP the link goes to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
